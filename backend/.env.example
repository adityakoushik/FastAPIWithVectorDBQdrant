# backend folder থেকে server চালাও; local values .env-এ রাখো।
INTC_APP_NAME=IntelliDocs API
INTC_APP_VERSION=1.0.0
INTC_QDRANT_URL=http://localhost:6333
INTC_QDRANT_COLLECTION=documents_v2
INTC_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Chunk-এর character limit এবং আগের অংশ পুনরায় রাখার মাপ।
INTC_CHUNK_SIZE=500
INTC_OVERLAP_SENTENCES=1
INTC_OVERSIZED_OVERLAP=50
INTC_SEARCH_DEFAULT_LIMIT=3
INTC_SEARCH_SCORE_THRESHOLD=0.4
